<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.12.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YARG.Core\YARG.Core.csproj" />
    <!-- ChordAnalyzer lives in the Unity assembly in production, but it has
         no Unity dependency. Link it into the Core test project so the
         Real Guitar analyzer front end is covered by normal dotnet tests. -->
    <Compile Include="..\..\Assets\Script\Audio\PitchDetection\ChordAnalyzer.cs"
             Link="Audio\ChordAnalyzer.cs" />
    <!-- DeepScanAnalyzer lives in the Unity assembly but its scan ordering,
         stem selection, confidence, and decode flags are testable without
         Unity.  It uses ManagedBass only for the audio path. -->
    <Compile Include="..\..\Assets\Script\DeepScan\DeepScanAnalyzer.cs"
             Link="DeepScan\DeepScanAnalyzer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ManagedBass">
      <HintPath>..\..\Assets\Packages\ManagedBass.3.1.1\lib\net45\ManagedBass.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
